# ---------------------------------------------------------------------------
# Ronak Fire India Pvt. Ltd. - Apache configuration
# ---------------------------------------------------------------------------

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php83" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# Correct MIME type for the banner video.
AddType video/mp4 .mp4

# --- Disable directory listing ---
Options -Indexes

# --- Block access to backups, databases and other non-public files ---
<FilesMatch "\.(zip|rar|7z|tar|gz|sql|bak|old|orig|log|ini|env|sh|dist|map)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(\.htaccess|\.htpasswd|\.env|\.git.*|composer\.(json|lock)|package(-lock)?\.json|README.*|LICENSE.*)$">
  Require all denied
</FilesMatch>

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; script-src 'self' https://www.googletagmanager.com; font-src 'self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://www.googletagmanager.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Browser caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# --- 301 redirects: old flat URLs -> new folder structure ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^index\.html$ / [R=301,L]

  RewriteRule ^about-us\.html$ /pages/about-us.html [R=301,L]
  RewriteRule ^contact-us\.html$ /pages/contact-us.html [R=301,L]
  RewriteRule ^products\.html$ /pages/products.html [R=301,L]
  RewriteRule ^privacy-policy\.html$ /pages/privacy-policy.html [R=301,L]
  RewriteRule ^refund-cancellation-policy\.html$ /pages/refund-cancellation-policy.html [R=301,L]
  RewriteRule ^testimonial\.html$ /pages/testimonial.html [R=301,L]

  RewriteRule ^extinguisher\.html$ /products/extinguisher.html [R=301,L]
  RewriteRule ^hose-reel-drums\.html$ /products/hose-reel-drums.html [R=301,L]
  RewriteRule ^hose-boxes-and-fire-shaft-door\.html$ /products/hose-boxes-and-fire-shaft-door.html [R=301,L]
  RewriteRule ^fire-hose\.html$ /products/fire-hose.html [R=301,L]
  RewriteRule ^breeching-inlet\.html$ /products/breeching-inlet.html [R=301,L]
  RewriteRule ^landing-valve\.html$ /products/landing-valve.html [R=301,L]
  RewriteRule ^sprinkler\.html$ /products/sprinkler.html [R=301,L]
  RewriteRule ^fire-hose-delivery-coupling\.html$ /products/fire-hose-delivery-coupling.html [R=301,L]
  RewriteRule ^branch-pipe-nozzle\.html$ /products/branch-pipe-nozzle.html [R=301,L]
</IfModule>

# --- Custom error page ---
ErrorDocument 404 /pages/404.html

# --- Optional: force HTTPS. Uncomment once SSL is confirmed for every host. ---
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
